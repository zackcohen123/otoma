# ── Salesforce ─────────────────────────────────────────────────────────────
# Your org's My Domain URL (Setup > My Domain). No trailing slash.
SF_LOGIN_URL=https://yourcompany.my.salesforce.com

# Consumer key from the External Client App / Connected App.
SF_CLIENT_ID=

# Option A (recommended): OAuth 2.0 Client Credentials flow.
SF_CLIENT_SECRET=

# Option B: OAuth 2.0 JWT Bearer flow. If SF_JWT_PRIVATE_KEY is set it wins.
# Paste the PEM with literal \n for newlines, or base64-encode the whole file.
# SF_USERNAME=integration.user@yourcompany.com
# SF_JWT_PRIVATE_KEY=

# Optional. Defaults shown.
# SF_API_VERSION=v63.0
# SF_PRIMARY_CONTACT_FIELD=Primary_Contact__c
# SF_RESOURCES_FIELD=Quick_Access_Resources__c
# SF_NEWS_TERM_FIELD=News_Search_Term__c

# Set to "demo" to render built-in sample data without a Salesforce connection.
# SALESFORCE_MODE=demo

# ── News (GNews.io) ────────────────────────────────────────────────────────
GNEWS_API_KEY=
# Hours to cache news per account (default 6). Free tier = 100 requests/day.
# NEWS_CACHE_HOURS=6

# Timezone used for "today", overdue and touch-count math (IANA name). Default UTC.
# APP_TIMEZONE=America/New_York
