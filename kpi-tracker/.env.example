# Copy to .env (never commit it). All of these are read on the server only.

# Zapier MCP server URL (Zapier > MCP > your server > Connect > Server URL).
# It contains a secret: never commit, log or expose it.
ZAPIER_MCP_URL=

# Optional: some Zapier MCP servers use a bearer token instead of a secret in the URL.
# ZAPIER_MCP_TOKEN=

# Password for the dashboard (HTTP basic auth). Required in production:
# without it the app serves a 503 instead of data. Username defaults to "otoma".
DASHBOARD_PASSWORD=
# DASHBOARD_USER=otoma

# Run on fixture data with no network access: MOCK=1 npm run dev
# MOCK=1
# Mock scenarios for the warning states: ok (default), truncated, empty, error
# MOCK_SCENARIO=ok

# Where the result cache and weekly history are stored. Default: .cache/ in this folder.
# CACHE_DIR=/var/data/gtm-kpis
